CONFIG_ENV=config.env

# Kimsultech Redmi 5 Plus / Redmi Note 5 Pro (vince) kernel
KERNEL_SOURCE=https://github.com/kimsultech/android_kernel_xiaomi_msm8953-4.9
KERNEL_SOURCE_BRANCH=PWR
KERNEL_CONFIG=msm8953_defconfig
ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# Build options
ENABLE_KERNELSU=false
ENABLE_LXC=false
ENABLE_NETHUNTER=false
ENABLE_CCACHE=true

# Keep the kernel's existing Kprobes and NetHunter configuration
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE-LTO=true
DISABLE_CC_WERROR=true
DISABLE_FST=false

# Do not create a boot image or expect a separate DTBO
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# Leave custom toolchains disabled; this workflow uses its bundled compiler
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS=